    match /staffRecurring/{key} { allow read, delete: if isAdmin(); allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['owner','day','index','employeeId','startDate','endDate','updatedAt']) && request.resource.data.updatedAt == request.time; }
    match /recurringSlots/{key} {
      allow read: if true;
      allow create, update: if isAdmin()
