    }
    function validStockInvoice(d,id) {
      let purchase = getAfter(/databases/$(database)/documents/stockMovements/$(id)).data;
      return d.keys().hasOnly(['itemId','invoiceNumber','warrantyEnd','fileName','mime','size','chunkCount','createdAt','updatedAt'])
        && d.keys().hasAll(['itemId','invoiceNumber','warrantyEnd','fileName','mime','size','chunkCount','createdAt','updatedAt'])
        && purchase.kind == 'purchase' && purchase.itemId == d.itemId
