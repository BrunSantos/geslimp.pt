    // Tudo o que não foi autorizado explicitamente continua privado.
    function portalSelf(emp) {
      let a = get(/databases/$(database)/documents/employeeAccess/$(request.auth.uid)).data;
      return request.auth != null && a.enabled == true && a.employeeId == emp
        && get(/databases/$(database)/documents/employees/$(emp)).data.status == 'ativo';
