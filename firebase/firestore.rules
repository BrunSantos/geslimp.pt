rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validId(id) { return id.matches('^[A-Za-z0-9-]{1,128}$'); }
    function validDay(day) { return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validSlots(slots) {
      return slots is list && slots.size() == 3
        && slots[0] is bool && slots[1] is bool && slots[2] is bool;
    }
    function validAvailability(data) {
      return data.keys().hasOnly(['slots','bookingId','updatedAt'])
        && data.keys().hasAll(['slots','bookingId','updatedAt'])
        && validSlots(data.slots) && data.bookingId is string
        && data.updatedAt == request.time;
    }
    function matchingBookingAfter(id, day) {
      let booking = getAfter(/databases/$(database)/documents/bookings/$(id)).data;
      return booking.day == day && booking.status in ['pendente','confirmada'];
    }
    function validBooking(data, id) {
      return data.keys().hasOnly(['name','day','shift','notes','status','createdAt','updatedAt','clientId','phone','email','address','postcode','city','requestedService','source','ownerUid'])
        && data.keys().hasAll(['name','day','shift','notes','status','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.day is string && validDay(data.day)
        && data.shift in ['Manhã','Tarde','Noite']
        && data.notes is string && data.notes.size() <= 5000
        && data.status in ['pendente','confirmada','cancelada']
        && data.createdAt is timestamp && data.updatedAt == request.time
        && (!('clientId' in data) || (data.clientId is string && validId(data.clientId)
          && existsAfter(/databases/$(database)/documents/clients/$(data.clientId))));
    }
    function validClient(data) {
      return data.keys().hasOnly(['name','phone','email','address','postcode','city','type','service','serviceDetails','notes','clientSince','createdAt','updatedAt'])
        && data.keys().hasAll(['name','phone','email','address','postcode','city','type','service','serviceDetails','notes','clientSince','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40 && data.phone.matches('.*[0-9].*')
        && data.email is string && data.email.size() <= 150
        && data.address is string && data.address.size() <= 200 && data.address.matches('.*[^ ].*')
        && data.postcode is string && data.postcode.matches('^[0-9]{4}-[0-9]{3}$')
        && data.city is string && data.city.size() <= 100 && data.city.matches('.*[^ ].*')
        && data.type in ['', 'Particular', 'Profissional']
        && data['service'] in ['', 'Casa completa','Divisões específicas da casa','Condomínio','Escritório','Espaço comercial','Limpeza pós-obra','Outra limpeza']
        && data.serviceDetails is string && data.serviceDetails.size() <= 5000
        && data.notes is string && data.notes.size() <= 5000
        && data.clientSince is string && validDay(data.clientSince)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function isVisitor() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validPublicBooking(data) {
      return isVisitor()
        && data.keys().hasOnly(['name','day','shift','notes','status','createdAt','updatedAt','phone','email','address','postcode','city','requestedService','source','ownerUid'])
        && data.keys().hasAll(['phone','email','address','postcode','city','requestedService','source','ownerUid'])
        && data.source == 'site' && data.ownerUid == request.auth.uid
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40 && data.phone.matches('.*[0-9].*')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150 && data.email.matches('.*@.*')
        && data.address is string && data.address.size() <= 200 && data.address.matches('.*[^ ].*')
        && data.postcode is string && data.postcode.matches('^[0-9]{4}-[0-9]{3}$')
        && data.city is string && data.city.size() <= 100
        && data.requestedService in ['Limpeza profunda','Limpeza pós-obra','Condomínio','Empresa','Serviço personalizado']
        && (data.requestedService != 'Serviço personalizado' || data.notes.size() > 0);
    }
    function visitorCanBook(data) {
      let day = get(/databases/$(database)/documents/availability/$(data.day)).data;
      return validPublicBooking(data) && day.bookingId == ''
        && ((data.shift == 'Manhã' && day.slots[0] == true)
          || (data.shift == 'Tarde' && day.slots[1] == true)
          || (data.shift == 'Noite' && day.slots[2] == true));
    }
    function visitorDayUpdate(day) {
      let bookingId = request.resource.data.bookingId;
      let booking = getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isVisitor() && validId(bookingId)
        && resource.data.bookingId == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingId','updatedAt'])
        && !exists(/databases/$(database)/documents/bookings/$(bookingId))
        && booking.day == day && booking.status == 'pendente'
        && booking.ownerUid == request.auth.uid && booking.source == 'site'
        && visitorCanBook(booking);
    }
    match /admins/{uid} {
      // Só a consola/Admin SDK atribui este papel. Nenhum visitante pode promover a sua conta.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /availability/{day} {
      // Estes documentos contêm apenas turnos, ocupação e data de atualização.
      allow read: if true;
      allow create: if isAdmin() && validDay(day) && validAvailability(request.resource.data)
        && request.resource.data.bookingId == '';
      allow update: if validDay(day) && validAvailability(request.resource.data)
        && ((isAdmin() && (request.resource.data.bookingId == resource.data.bookingId
          || (resource.data.bookingId == '' && validId(request.resource.data.bookingId)
              && matchingBookingAfter(request.resource.data.bookingId, day))
          || (request.resource.data.bookingId == ''
              && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'cancelada')))
          || visitorDayUpdate(day));
      allow delete: if false;
    }
    match /bookings/{id} {
      allow read: if isAdmin();
      allow create: if validId(id) && validBooking(request.resource.data,id)
        && (isAdmin() || visitorCanBook(request.resource.data))
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/availability/$(request.resource.data.day)).data.bookingId == id;
      allow update: if isAdmin() && validBooking(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientId','updatedAt'])
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'pendente' && request.resource.data.status in ['confirmada','cancelada'])
          || (resource.data.status == 'confirmada' && request.resource.data.status == 'cancelada'))
        && (request.resource.data.status == 'cancelada'
          ? getAfter(/databases/$(database)/documents/availability/$(resource.data.day)).data.bookingId != id
          : getAfter(/databases/$(database)/documents/availability/$(resource.data.day)).data.bookingId == id);
      allow delete: if isAdmin() && resource.data.status == 'cancelada'
        && get(/databases/$(database)/documents/availability/$(resource.data.day)).data.bookingId != id;
    }
    match /clients/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validClient(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validId(id) && validClient(request.resource.data)
        && ('createdAt' in resource.data
          ? request.resource.data.createdAt == resource.data.createdAt
          : request.resource.data.createdAt == request.time);
      allow delete: if isAdmin();
    }
    function validService(data) {
      return data.keys().hasOnly(['clientId','title','serviceType','frequency','startDate','estimatedDuration','areas','notes','createdAt','updatedAt','endDate','status'])
        && data.keys().hasAll(['clientId','title','serviceType','frequency','startDate','estimatedDuration','areas','notes','createdAt','updatedAt'])
        && data.clientId is string && validId(data.clientId)
        && existsAfter(/databases/$(database)/documents/clients/$(data.clientId))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.serviceType in ['Casa completa','Divisões específicas da casa','Condomínio','Escritório','Espaço comercial','Limpeza pós-obra','Outra limpeza']
        && data.frequency in ['Pontual','Diário','Semanal','Quinzenal','Mensal','Outro']
        && data.startDate is string && validDay(data.startDate)
        && (!('status' in data) || data.status in ['ativo','concluido','cancelado'])
        && (!('endDate' in data) || (data.endDate is string && (data.endDate == '' || (validDay(data.endDate) && data.endDate >= data.startDate))))
        && (data.frequency != 'Pontual' || !('endDate' in data) || data.endDate == data.startDate)
        && data.estimatedDuration is string && data.estimatedDuration.size() <= 80
        && data.areas is string && data.areas.size() <= 5000
        && data.notes is string && data.notes.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /services/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validService(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validService(request.resource.data)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() && resource.data.status == 'cancelado';
    }
    function quoteFields(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() <= 150
        && d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.clientId is string && (d.clientId == '' || exists(/databases/$(database)/documents/clients/$(d.clientId)))
        && d.date is string && validDay(d.date) && d.valid is string && validDay(d.valid) && d.valid >= d.date
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 30
        && d.discount is number && d.discount >= 0 && d.discount <= 100
        && d.vat is number && d.vat >= 0 && d.vat <= 100
        && d.scope is string && d.scope.size() <= 5000
        && d.terms is string && d.terms.size() <= 5000
        && d.notes is string && d.notes.size() <= 5000
        && d.address is string && d.address.size() <= 300
        && d.materials is string && d.materials.size() <= 500
        && d.taxnote is string && d.taxnote.size() <= 300
        && d.frequency in ['Pontual','Diário','Semanal','Quinzenal','Mensal','Outro']
        && d.type in ['Casa completa','Limpeza pós-obra','Condomínio','Escritório','Espaço comercial','Divisões específicas da casa','Outra limpeza']
        && d.updatedAt == request.time;
    }
    match /quoteCounters/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && id == 'main' && request.resource.data.keys().hasOnly(['value']) && request.resource.data.value == 1;
      allow update: if isAdmin() && id == 'main' && request.resource.data.keys().hasOnly(['value']) && request.resource.data.value == resource.data.value + 1;
    }
    match /quotes/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && quoteFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['name','email','address','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','notes','clientId','lines','number','revision','parentId','status','serviceId','linkId','createdAt','updatedAt'])
        && request.resource.data.status == 'rascunho' && request.resource.data.serviceId == ''
        && request.resource.data.number is string && request.resource.data.number.size() <= 30
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.parentId is string
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','serviceId','linkId','updatedAt'])
        && request.resource.data.status in ['rascunho','enviado','aceite','recusado','expirado']
        && (request.resource.data.get('linkId','') == '' || (
          request.resource.data.linkId.matches('^[a-f0-9]{64}$')
          && (request.resource.data.status != 'aceite' || (
            getAfter(/databases/$(database)/documents/quoteLinks/$(request.resource.data.linkId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/quoteLinks/$(request.resource.data.linkId)).data.quoteId == id))))
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.serviceId == resource.data.serviceId
          || (resource.data.serviceId == '' && request.resource.data.status == 'aceite'
            && request.resource.data.serviceId == 'quote-' + id
            && getAfter(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId == resource.data.clientId));
    }
    match /quoteTemplates/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validId(id)
        && request.resource.data.keys().hasOnly(['title','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.scope is string && request.resource.data.scope.size() <= 5000
        && request.resource.data.terms is string && request.resource.data.terms.size() <= 5000
        && request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }
    function cleanPublicQuote(d) {
      return d.keys().hasOnly(['name','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','number','revision'])
        && d.keys().hasAll(['name','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','number','revision']);
    }
    function linkShape(d) {
      return d.keys().hasOnly(['quoteId','quote','status','expiresAt','clientChoice','clientComment','clientAt','finalComment','finalAt','history','updatedAt'])
        && cleanPublicQuote(d.quote)
        && validId(d.quoteId) && d.expiresAt is timestamp
        && d.history is list && d.history.size() <= 20
        && d.clientComment is string && d.clientComment.size() <= 2000
        && d.finalComment is string && d.finalComment.size() <= 2000
        && d.updatedAt == request.time;
    }
    function snapshotMatches(d) {
      let q = getAfter(/databases/$(database)/documents/quotes/$(d.quoteId)).data;
      return d.quote.name == q.name && d.quote.title == q.title && d.quote.date == q.date
        && d.quote.valid == q.valid && d.quote.frequency == q.frequency && d.quote.type == q.type
        && d.quote.discount == q.discount && d.quote.vat == q.vat && d.quote.taxnote == q.taxnote
        && d.quote.scope == q.scope && d.quote.terms == q.terms && d.quote.materials == q.materials
        && d.quote.lines == q.lines && d.quote.number == q.number && d.quote.revision == q.revision;
    }
    match /quoteLinks/{token} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (token.matches('^[a-f0-9]{64}$') && resource.data.status != 'revoked');
      allow create: if isAdmin() && token.matches('^[a-f0-9]{64}$')
        && linkShape(request.resource.data) && snapshotMatches(request.resource.data)
        && request.resource.data.status == 'awaiting_client'
        && request.resource.data.clientChoice == '' && request.resource.data.clientComment == ''
        && request.resource.data.clientAt == null && request.resource.data.finalAt == null
        && request.resource.data.finalComment == '' && request.resource.data.history.size() == 0
        && request.resource.data.expiresAt > request.time;
      allow update: if (isAdmin() && linkShape(request.resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status == 'revoked')
        || (resource.data.status == 'awaiting_geslimp'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalComment','finalAt','updatedAt'])
          && request.resource.data.status in ['accepted','refused']
          && (request.resource.data.status != 'accepted' || resource.data.clientChoice == 'accepted')
          && request.resource.data.finalComment.size() > 0 && request.resource.data.finalAt == request.time)
        || (resource.data.status != 'revoked' && request.resource.data.quoteId != resource.data.quoteId
          && getAfter(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.parentId == resource.data.quoteId
          && snapshotMatches(request.resource.data)
          && request.resource.data.status == 'awaiting_client' && request.resource.data.expiresAt > request.time
          && request.resource.data.clientChoice == '' && request.resource.data.clientComment == ''
          && request.resource.data.clientAt == null && request.resource.data.finalAt == null && request.resource.data.finalComment == ''
          && request.resource.data.history.size() == resource.data.history.size() + 1)
      )) || (
        request.auth != null && token.matches('^[a-f0-9]{64}$')
        && resource.data.status == 'awaiting_client' && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientChoice','clientComment','clientAt','updatedAt'])
        && request.resource.data.status == 'awaiting_geslimp'
        && request.resource.data.clientChoice in ['accepted','refused']
        && request.resource.data.clientComment is string && request.resource.data.clientComment.size() <= 2000
        && (request.resource.data.clientChoice != 'refused' || request.resource.data.clientComment.size() > 0)
        && request.resource.data.clientAt == request.time && request.resource.data.updatedAt == request.time
      );
    }
    // Tudo o que não foi autorizado explicitamente continua privado.
    match /{document=**} { allow read, write: if false; }
  }
}
