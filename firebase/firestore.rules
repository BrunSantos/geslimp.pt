        || (d.type == 'loan' && get(/databases/$(database)/documents/stockLoans/$(d.sourceId)).data.employeeId == emp)
        || (d.type == 'booking' && get(/databases/$(database)/documents/bookings/$(d.sourceId)).data.status != 'cancelada' && (get(/databases/$(database)/documents/bookings/$(d.sourceId)).data.get('employeeIds',null) != null ? get(/databases/$(database)/documents/bookings/$(d.sourceId)).data.employeeIds.hasAny([emp]) : assignedClient(d.clientId,emp)))
        || (d.type == 'service' && get(/databases/$(database)/documents/services/$(d.sourceId)).data.get('status','ativo') != 'cancelado'
          && (get(/databases/$(database)/documents/services/$(d.sourceId)).data.get('employeeIds',null) != null ? get(/databases/$(database)/documents/services/$(d.sourceId)).data.employeeIds.hasAny([emp]) : (get(/databases/$(database)/documents/services/$(d.sourceId)).data.get('employeeId','') == emp
