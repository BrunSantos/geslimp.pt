    match /adminNotificationPreferences/{uid} {
      allow get: if isAdmin() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isAdmin() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['enabled','updatedAt'])
        && request.resource.data.enabled is map && request.resource.data.enabled.keys().hasOnly(['stock','loans','services','monthly','bookings','quotes','incidents','reschedules'])
        && request.resource.data.enabled.get('stock',true) is bool && request.resource.data.enabled.get('loans',true) is bool
        && request.resource.data.enabled.get('incidents',true) is bool
        && request.resource.data.enabled.get('reschedules',true) is bool
        && request.resource.data.enabled.get('services',true) is bool && request.resource.data.enabled.get('monthly',true) is bool
        && request.resource.data.enabled.get('bookings',true) is bool && request.resource.data.enabled.get('quotes',true) is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /serviceRates/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['serviceId','month','mode','amountCents','updatedAt'])
        && validId(request.resource.data.serviceId) && validBillingMonth(request.resource.data.month)
        && id == request.resource.data.serviceId + '-' + request.resource.data.month
        && existsAfter(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && request.resource.data.mode in ['monthly','once']
        && request.resource.data.amountCents is int && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 100000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /monthlyBilling/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['serviceId','month','paidCents','updatedAt'])
        && validId(request.resource.data.serviceId) && validBillingMonth(request.resource.data.month)
        && id == request.resource.data.serviceId + '-' + request.resource.data.month
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && request.resource.data.paidCents is int && request.resource.data.paidCents >= 0 && request.resource.data.paidCents <= 1000000000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /reportSettings/counters {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['resetAt','resetBy'])
        && request.resource.data.keys().hasAll(['resetAt','resetBy'])
        && request.resource.data.resetAt == request.time
        && request.resource.data.resetBy == request.auth.uid;
      allow delete: if false;
    }
    match /services/{serviceId}/changeHistory/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind','before','after','reason','actorUid','actorName','createdAt','status','requestId','resultServiceId'])
        && request.resource.data.kind == 'reschedule'
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 5000
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
