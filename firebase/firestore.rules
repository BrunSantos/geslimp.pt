        && request.resource.data.serviceId is string && (request.resource.data.serviceId == '' || get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId == request.resource.data.clientId)
        && request.resource.data.clientName == get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.name
