rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validId(id) { return id.matches('^[A-Za-z0-9-]{1,128}$'); }
    function validDay(day) { return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validSlots(slots) {
      return slots is list && slots.size() == 3
        && slots[0] is bool && slots[1] is bool && slots[2] is bool;
    }
    function validAvailability(data) {
      return data.keys().hasOnly(['slots','bookingId','updatedAt','capacity','reservations'])
        && data.keys().hasAll(['slots','bookingId','updatedAt'])
        && (!isCapacity(data) || validCapacity(data))
        && validSlots(data.slots) && data.bookingId is string
        && data.updatedAt == request.time;
    }
    function matchingBookingAfter(id, day) {
      let booking = getAfter(/databases/$(database)/documents/bookings/$(id)).data;
      return booking.day == day && booking.status in ['pendente','confirmada','concluida'];
    }
    function validBooking(data, id) {
      return data.keys().hasOnly(['name','day','shift','notes','status','createdAt','updatedAt','clientId','phone','email','address','postcode','city','requestedService','source','ownerUid','workersNeeded','employeeIds'])
        && data.keys().hasAll(['name','day','shift','notes','status','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.day is string && validDay(data.day)
        && data.shift in ['Manhã','Tarde','Noite','Dia inteiro']
        && data.notes is string && data.notes.size() <= 5000
        && data.status in ['pendente','confirmada','cancelada','concluida']
        && (!('workersNeeded' in data) || (data.workersNeeded is int && data.workersNeeded >= 1 && data.workersNeeded <= 5))
        && (!('employeeIds' in data) || (data.employeeIds is list && data.employeeIds.size() <= 5 && data.employeeIds.toSet().size() == data.employeeIds.size()))
        && data.createdAt is timestamp && data.updatedAt == request.time
        && (!('clientId' in data) || (data.clientId is string && validId(data.clientId)
          && existsAfter(/databases/$(database)/documents/clients/$(data.clientId))));
    }
    function validClient(data) {
      return employeeReference(data) && data.keys().hasOnly(['name','phone','email','address','postcode','city','type','service','serviceDetails','notes','clientSince','createdAt','updatedAt','employeeId'])
        && data.keys().hasAll(['name','phone','email','address','postcode','city','type','service','serviceDetails','notes','clientSince','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40 && data.phone.matches('.*[0-9].*')
        && data.email is string && data.email.size() <= 150
        && data.address is string && data.address.size() <= 200 && data.address.matches('.*[^ ].*')
        && data.postcode is string && data.postcode.matches('^[0-9]{4}-[0-9]{3}$')
        && data.city is string && data.city.size() <= 100 && data.city.matches('.*[^ ].*')
        && data.type in ['', 'Particular', 'Profissional']
        && data['service'] in ['', 'Casa completa','Divisões específicas da casa','Condomínio','Escritório','Espaço comercial','Limpeza pós-obra','Outra limpeza']
        && data.serviceDetails is string && data.serviceDetails.size() <= 5000
        && data.notes is string && data.notes.size() <= 5000
        && data.clientSince is string && validDay(data.clientSince)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function isVisitor() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validPublicBooking(data) {
      return isVisitor()
        && data.keys().hasOnly(['name','day','shift','notes','status','createdAt','updatedAt','phone','email','address','postcode','city','requestedService','source','ownerUid','workersNeeded','employeeIds'])
        && data.keys().hasAll(['phone','email','address','postcode','city','requestedService','source','ownerUid'])
        && data.source == 'site' && data.ownerUid == request.auth.uid
        && data.get('workersNeeded',1) == 1 && data.get('employeeIds',[]) == []
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40 && data.phone.matches('.*[0-9].*')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150 && data.email.matches('.*@.*')
        && data.address is string && data.address.size() <= 200 && data.address.matches('.*[^ ].*')
        && data.postcode is string && data.postcode.matches('^[0-9]{4}-[0-9]{3}$')
        && data.city is string && data.city.size() <= 100
        && data.requestedService in ['Limpeza profunda','Limpeza pós-obra','Condomínio','Empresa','Serviço personalizado']
        && (data.requestedService != 'Serviço personalizado' || data.notes.size() > 0);
    }
    function weekOf(day) { let p = day.split('-'); return timestamp.date(int(p[0]),int(p[1]),int(p[2])).dayOfWeek(); }
    function isCapacity(d) { return 'capacity' in d; }
    function validCapacity(d) {
      return d.capacity is list && d.capacity.size() == 3 && d.reservations is map && d.reservations.keys().hasOnly(['0','1','2']) && d.reservations.keys().hasAll(['0','1','2'])
        && d.capacity[0] is int && d.capacity[0] >= 0 && d.capacity[0] <= 20
        && d.capacity[1] is int && d.capacity[1] >= 0 && d.capacity[1] <= 20
        && d.capacity[2] is int && d.capacity[2] >= 0 && d.capacity[2] <= 20
        && d.reservations['0'] is list && d.reservations['0'].size() <= 100
        && d.reservations['1'] is list && d.reservations['1'].size() <= 100
        && d.reservations['2'] is list && d.reservations['2'].size() <= 100;
    }
    function dayStamp(day) { let p=day.split('-'); return timestamp.date(int(p[0]),int(p[1]),int(p[2])); }
    function inFortnight(start,day) { return (dayStamp(day)-dayStamp(start)).seconds() % 1209600 < 604800; }
    function rowSeats(rows,i,day) { return rows.size() > i && day >= rows[i].startDate && (rows[i].endDate == '' || day <= rows[i].endDate) && !(day in rows[i].get('excludedDays',[])) && (rows[i].get('frequency','Semanal') != 'Quinzenal' || inFortnight(rows[i].startDate,day)) ? rows[i].seats : 0; }
    function weeklySeats(day,index) {
      let key=string(weekOf(day))+'-'+string(index);
      let d=exists(/databases/$(database)/documents/recurringSlots/$(key)) ? get(/databases/$(database)/documents/recurringSlots/$(key)).data : {};
      let rows=d.get('entries',[]);
      return 'serviceId' in d ? (day >= d.startDate && (d.endDate == '' || day <= d.endDate) ? 1 : 0)
        : (rows.size() == 0 ? 0 : (rows.size() > 0 ? rowSeats(rows,0,day) : 0)+(rows.size() > 1 ? rowSeats(rows,1,day) : 0)+(rows.size() > 2 ? rowSeats(rows,2,day) : 0)+(rows.size() > 3 ? rowSeats(rows,3,day) : 0)+(rows.size() > 4 ? rowSeats(rows,4,day) : 0)+(rows.size() > 5 ? rowSeats(rows,5,day) : 0)+(rows.size() > 6 ? rowSeats(rows,6,day) : 0)+(rows.size() > 7 ? rowSeats(rows,7,day) : 0)+(rows.size() > 8 ? rowSeats(rows,8,day) : 0)+(rows.size() > 9 ? rowSeats(rows,9,day) : 0));
    }
    function recurringFree(day,index) { return weeklySeats(day,index) == 0; }
    function shiftIndex(shift) { return shift == 'Manhã' ? 0 : shift == 'Tarde' ? 1 : 2; }
    function turnRoom(d,day,index,count) { return d.slots[index] && d.reservations[string(index)].size()+weeklySeats(day,index)+count <= d.capacity[index]; }
    function capacityRoom(d,b) { return b.shift == 'Dia inteiro'
      ? turnRoom(d,b.day,0,b.get('workersNeeded',1)) && turnRoom(d,b.day,1,b.get('workersNeeded',1)) && turnRoom(d,b.day,2,b.get('workersNeeded',1))
      : turnRoom(d,b.day,shiftIndex(b.shift),b.get('workersNeeded',1)); }
    function reservedCount(d,id,i) { return d.reservations[string(i)].size()-d.reservations[string(i)].removeAll([id]).size(); }
    function bookingStored(id,b) {
      let d=getAfter(/databases/$(database)/documents/availability/$(b.day)).data;
      let count=b.status == 'cancelada' ? 0 : b.get('workersNeeded',1);
      return isCapacity(d) ? reservedCount(d,id,0) == (b.shift in ['Manhã','Dia inteiro'] ? count : 0)
        && reservedCount(d,id,1) == (b.shift in ['Tarde','Dia inteiro'] ? count : 0)
        && reservedCount(d,id,2) == (b.shift in ['Noite','Dia inteiro'] ? count : 0)
        : (b.status == 'cancelada' ? d.bookingId != id : d.bookingId == id);
    }
    function capacityVisitorUpdate(day) {
      let before=resource.data;
      let after=request.resource.data;
      let changed=after.reservations['0'] != before.reservations['0'] ? 0 : after.reservations['1'] != before.reservations['1'] ? 1 : 2;
      let id=after.reservations[string(changed)][after.reservations[string(changed)].size()-1];
      let b=getAfter(/databases/$(database)/documents/bookings/$(id)).data;
      return isVisitor() && validId(id) && b.source == 'site' && b.ownerUid == request.auth.uid && b.get('workersNeeded',1) == 1 && b.day == day && b.status == 'pendente'
        && !exists(/databases/$(database)/documents/bookings/$(id)) && shiftIndex(b.shift) == changed
        && after.diff(before).affectedKeys().hasOnly(['reservations','updatedAt']) && turnRoom(before,day,changed,1)
        && after.reservations[string(changed)] == before.reservations[string(changed)].concat([id])
        && (changed == 0 || after.reservations['0'] == before.reservations['0'])
        && (changed == 1 || after.reservations['1'] == before.reservations['1'])
        && (changed == 2 || after.reservations['2'] == before.reservations['2']);
    }
    function freeBooking(b) {
      let d=get(/databases/$(database)/documents/availability/$(b.day)).data;
      return isCapacity(d) ? capacityRoom(d,b) : (b.shift == 'Manhã' ? recurringFree(b.day,0) : b.shift == 'Tarde' ? recurringFree(b.day,1) : b.shift == 'Noite' ? recurringFree(b.day,2) : recurringFree(b.day,0) && recurringFree(b.day,1) && recurringFree(b.day,2));
    }
    function freeOpening(day,slots) { return (!slots[0] || recurringFree(day,0)) && (!slots[1] || recurringFree(day,1)) && (!slots[2] || recurringFree(day,2)); }
    function serviceSlot(d) { return string(d.weekday) + '-' + string(d.shift == 'Manhã' ? 0 : d.shift == 'Tarde' ? 1 : 2); }
    function serviceLock(id,d) {
      return !(d.frequency in ['Semanal','Quinzenal']) || d.get('status','ativo') != 'ativo'
        || (getAfter(/databases/$(database)/documents/recurringSlots/$(serviceSlot(d))).data.get('serviceId','') == id || getAfter(/databases/$(database)/documents/recurringSlots/$(serviceSlot(d))).data.get('serviceIds',[]).hasAny([id]));
    }
    function visitorCanBook(data) {
      let day = get(/databases/$(database)/documents/availability/$(data.day)).data;
      return validPublicBooking(data) && (isCapacity(day) ? capacityRoom(day,data) : day.bookingId == ''
        && ((data.shift == 'Manhã' && day.slots[0] == true)
          || (data.shift == 'Tarde' && day.slots[1] == true)
          || (data.shift == 'Noite' && day.slots[2] == true)));
    }
    function visitorDayUpdate(day) {
      let bookingId = request.resource.data.bookingId;
      let booking = getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isVisitor() && validId(bookingId)
        && resource.data.bookingId == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingId','updatedAt'])
        && !exists(/databases/$(database)/documents/bookings/$(bookingId))
        && booking.day == day && booking.status == 'pendente'
        && booking.ownerUid == request.auth.uid && booking.source == 'site'
        && visitorCanBook(booking);
    }
    match /adminProfiles/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','updatedAt'])
        && request.resource.data.keys().hasAll(['email','updatedAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function assignedServiceEmployee(sid,emp) {
      let s = get(/databases/$(database)/documents/services/$(sid)).data;
      return s.get('status','ativo') != 'cancelado'
        && (s.get('employeeIds',null) != null ? s.employeeIds.hasAny([emp])
          : (s.get('employeeId','') != '' ? s.employeeId == emp : assignedClient(s.clientId,emp)));
    }
    function workSelf(emp) {
      return request.auth != null && (isAdmin()
        ? get(/databases/$(database)/documents/employees/$(emp)).data.email.lower() == request.auth.token.email.lower()
          && get(/databases/$(database)/documents/employees/$(emp)).data.status == 'ativo'
        : portalSelf(emp));
    }
    function portalServiceWorker(sid) {
      let a = get(/databases/$(database)/documents/employeeAccess/$(request.auth.uid)).data;
      return portalSelf(a.employeeId) && assignedServiceEmployee(sid,a.employeeId);
    }
    function serviceWorkDay(sid,day) {
      let s = get(/databases/$(database)/documents/services/$(sid)).data;
      let parts = day.split('-');
      return validDay(day) && !(day in s.get('excludedDays',[])) && day >= s.startDate
        && (s.get('endDate','') == '' || day <= s.endDate)
        && (s.frequency == 'Pontual' ? day == s.startDate : s.frequency in ['Semanal','Quinzenal'] && weekOf(day) == s.weekday && (s.frequency != 'Quinzenal' || inFortnight(s.startDate,day)))
        && timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) <= request.time + duration.value(1,'h');
    }
    function workShape(d,sid,day,uid) {
      return d.keys().hasOnly(['serviceId','clientId','day','employeeId','uid','status','startedAt','finishedAt','comment','updatedAt'])
        && d.keys().hasAll(['serviceId','clientId','day','employeeId','uid','status','startedAt','finishedAt','comment','updatedAt'])
        && d.serviceId == sid && d.day == day && d.uid == uid && uid == request.auth.uid
        && d.employeeId is string && workSelf(d.employeeId) && assignedServiceEmployee(sid,d.employeeId)
        && d.clientId == get(/databases/$(database)/documents/services/$(sid)).data.clientId
        && serviceWorkDay(sid,day) && d.status in ['started','completed','incident']
        && d.comment is string && d.comment.size() <= 5000 && d.updatedAt == request.time;
    }
    match /serviceWork/{sid}/days/{day}/workers/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid && portalServiceWorker(sid));
      allow list: if isAdmin();
      allow create: if request.auth != null && workShape(request.resource.data,sid,day,uid)
        && request.resource.data.status in ['started','incident'] && request.resource.data.finishedAt == null
        && request.resource.data.comment == ''
        && (request.resource.data.status == 'started' ? request.resource.data.startedAt == request.time : request.resource.data.startedAt == null);
      allow update: if request.auth != null && workShape(request.resource.data,sid,day,uid)
        && resource.data.status != 'completed' && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt','finishedAt','comment','updatedAt'])
        && (request.resource.data.status == 'started'
          ? resource.data.status == 'incident' && request.resource.data.startedAt == (resource.data.startedAt == null ? request.time : resource.data.startedAt)
            && request.resource.data.finishedAt == null && request.resource.data.comment == ''
          : request.resource.data.status == 'completed'
            ? resource.data.status == 'started' && request.resource.data.startedAt == resource.data.startedAt
              && request.resource.data.finishedAt == request.time
            : request.resource.data.startedAt == resource.data.startedAt && request.resource.data.finishedAt == null && request.resource.data.comment == '');
      allow delete: if false;
    }
    match /{path=**}/workers/{uid} { allow read: if isAdmin(); }
    function workFinished(sid,day) {
      return getAfter(/databases/$(database)/documents/serviceWork/$(sid)/days/$(day)/workers/$(request.auth.uid)).data.status == 'completed';
    }
    match /serviceRescheduleRequests/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid && portalSelf(get(/databases/$(database)/documents/employeeAccess/$(request.auth.uid)).data.employeeId));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','employeeId','serviceId','clientId','day','originalShift','targetDay','targetShift','message','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','employeeId','serviceId','clientId','day','originalShift','targetDay','targetShift','message','status','createdAt'])
        && request.resource.data.uid == request.auth.uid && workSelf(request.resource.data.employeeId)
        && assignedServiceEmployee(request.resource.data.serviceId,request.resource.data.employeeId)
        && request.resource.data.clientId == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.get('status','ativo') == 'ativo'
        && !(request.resource.data.day in get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.get('excludedDays',[]))
        && (get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.frequency == 'Pontual' ? request.resource.data.day == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.startDate : request.resource.data.day >= get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.startDate && (get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.get('endDate','') == '' || request.resource.data.day <= get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.endDate) && weekOf(request.resource.data.day) == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.weekday && (get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.frequency != 'Quinzenal' || inFortnight(get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.startDate,request.resource.data.day)))
        && validDay(request.resource.data.day) && validDay(request.resource.data.targetDay)
        && timestamp.date(int(request.resource.data.targetDay.split('-')[0]),int(request.resource.data.targetDay.split('-')[1]),int(request.resource.data.targetDay.split('-')[2])) + duration.value(25,'h') > request.time
        && request.resource.data.originalShift == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.shift
        && request.resource.data.targetShift in ['Manhã','Tarde','Noite']
        && (request.resource.data.targetDay != request.resource.data.day || request.resource.data.targetShift != request.resource.data.originalShift)
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedBy','decidedAt','resultServiceId'])
        && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time;
      allow delete: if false;
    }
    match /serviceIncidents/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null && validId(id)
        && request.resource.data.keys().hasOnly(['serviceId','clientId','day','employeeId','uid','message','status','createdAt'])
        && request.resource.data.keys().hasAll(['serviceId','clientId','day','employeeId','uid','message','status','createdAt'])
        && request.resource.data.uid == request.auth.uid && workSelf(request.resource.data.employeeId)
        && assignedServiceEmployee(request.resource.data.serviceId,request.resource.data.employeeId)
        && serviceWorkDay(request.resource.data.serviceId,request.resource.data.day)
        && request.resource.data.clientId == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && resource.data.status == 'open' && request.resource.data.status == 'resolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','resolvedBy','resolvedAt'])
        && request.resource.data.resolution is string && request.resource.data.resolution.size() <= 5000
        && request.resource.data.resolvedBy == request.auth.uid && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }
    function servicePhotoAccess(serviceId) {
      let a = get(/databases/$(database)/documents/employeeAccess/$(request.auth.uid)).data;
      let s = get(/databases/$(database)/documents/services/$(serviceId)).data;
      return portalSelf(a.employeeId) && s.frequency == 'Pontual' && s.get('status','ativo') != 'cancelado'
        && (s.get('employeeIds',null) != null ? s.employeeIds.hasAny([a.employeeId])
          : (s.get('employeeId','') != '' ? s.employeeId == a.employeeId : assignedClient(s.clientId,a.employeeId)));
    }
    match /servicePhotos/{serviceId}/photos/{photoId} {
      allow read: if isAdmin() || (request.auth != null && servicePhotoAccess(serviceId));
      allow create: if request.auth != null && (isAdmin() || servicePhotoAccess(serviceId))
        && exists(/databases/$(database)/documents/services/$(serviceId))
        && get(/databases/$(database)/documents/services/$(serviceId)).data.frequency == 'Pontual'
        && validId(photoId)
        && request.resource.data.keys().hasOnly(['phase','dataUrl','createdBy','createdAt'])
        && request.resource.data.keys().hasAll(['phase','dataUrl','createdBy','createdAt'])
        && request.resource.data.phase in ['before','after']
        && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() <= 350000
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /employeeAdminLinks/{employeeId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','email','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','email','updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(employeeId))
        && get(/databases/$(database)/documents/admins/$(request.resource.data.uid)).data.enabled == true;
      allow delete: if false;
    }
    match /admins/{uid} {
      // Só a consola/Admin SDK atribui este papel. Nenhum visitante pode promover a sua conta.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    function openingHistoryUpdated(day) {
      let h = getAfter(/databases/$(database)/documents/availabilityHistory/$(day)).data;
      return h.updatedAt == request.time
        && (!request.resource.data.slots[0] || h.slots[0])
        && (!request.resource.data.slots[1] || h.slots[1])
        && (!request.resource.data.slots[2] || h.slots[2]);
    }
    function historySlots(day, previous) {
      let before = exists(/databases/$(database)/documents/availability/$(day))
        ? get(/databases/$(database)/documents/availability/$(day)).data.slots : [false,false,false];
      let after = getAfter(/databases/$(database)/documents/availability/$(day)).data;
      return after.updatedAt == request.time
        && request.resource.data.slots[0] == (previous[0] || before[0] || after.slots[0])
        && request.resource.data.slots[1] == (previous[1] || before[1] || after.slots[1])
        && request.resource.data.slots[2] == (previous[2] || before[2] || after.slots[2]);
    }
    function validHistoryCounter(data) {
      return !('countResetAt' in data) && !('countSlots' in data)
        || data.keys().hasAll(['countResetAt','countSlots']) && data.countResetAt is timestamp
          && validSlots(data.countSlots)
          && data.countResetAt == get(/databases/$(database)/documents/reportSettings/counters).data.resetAt;
    }
    match /availabilityHistory/{day} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validDay(day)
        && request.resource.data.keys().hasOnly(['slots','createdAt','updatedAt','countResetAt','countSlots']) && validSlots(request.resource.data.slots) && validHistoryCounter(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && historySlots(day,[false,false,false]);
      allow update: if isAdmin() && validDay(day)
        && request.resource.data.keys().hasOnly(['slots','createdAt','updatedAt','countResetAt','countSlots']) && validSlots(request.resource.data.slots) && validHistoryCounter(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time
        && historySlots(day,resource.data.slots);
      allow delete: if false;
    }

    match /availability/{day} {
      // Estes documentos contêm apenas turnos, ocupação e data de atualização.
      allow read: if true;
      allow create: if isAdmin() && validDay(day) && validAvailability(request.resource.data)
        && request.resource.data.bookingId == '' && openingHistoryUpdated(day) && (isCapacity(request.resource.data) || freeOpening(day,request.resource.data.slots));
      allow update: if validDay(day) && validAvailability(request.resource.data)
        && ((isAdmin() && (isCapacity(request.resource.data)
          ? (request.resource.data.slots == resource.data.slots || openingHistoryUpdated(day))
          : (request.resource.data.slots == resource.data.slots || openingHistoryUpdated(day))))
          || (isCapacity(resource.data) ? capacityVisitorUpdate(day) : visitorDayUpdate(day)));
      allow delete: if false;
    }
    match /bookings/{id} {
      allow update: if isAdmin() && validBooking(request.resource.data,id)
        && resource.data.status in ['pendente','confirmada'] && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day','shift','updatedAt'])
        && bookingStored(id,request.resource.data);
      allow update: if request.auth != null && resource.data.status in ['confirmada','concluida'] && request.resource.data.status == 'concluida'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time && workFinished('site-'+id,resource.data.day)
        && get(/databases/$(database)/documents/services/$('site-'+id)).data.clientId == resource.data.clientId
        && (isAdmin() || portalServiceWorker('site-'+id));
      allow read: if isAdmin();
      allow create: if validId(id) && validBooking(request.resource.data,id)
        && (isAdmin() ? freeBooking(request.resource.data) : (isCapacity(get(/databases/$(database)/documents/availability/$(request.resource.data.day)).data) ? validPublicBooking(request.resource.data) : visitorCanBook(request.resource.data)))
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time
        && bookingStored(id,request.resource.data);
      allow update: if isAdmin() && validBooking(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientId','employeeIds','workersNeeded','updatedAt'])
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'pendente' && request.resource.data.status in ['confirmada','cancelada'])
          || (resource.data.status == 'confirmada' && request.resource.data.status in ['cancelada','concluida']))
        && bookingStored(id,request.resource.data);
      allow delete: if isAdmin() && resource.data.status == 'cancelada'
        && get(/databases/$(database)/documents/availability/$(resource.data.day)).data.bookingId != id;
    }
    match /clients/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validClient(request.resource.data) && activeEmployee(request.resource.data.get('employeeId',''))
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validId(id) && validClient(request.resource.data) && changedEmployeeAllowed(request.resource.data,resource.data)
        && ('createdAt' in resource.data
          ? request.resource.data.createdAt == resource.data.createdAt
          : request.resource.data.createdAt == request.time);
      allow delete: if isAdmin();
    }
    function validService(data) {
      return (!('excludedDays' in data) || (data.excludedDays is list && data.excludedDays.size() <= 2000)) && employeeReference(data) && data.keys().hasOnly(['clientId','title','serviceType','frequency','startDate','estimatedDuration','areas','notes','createdAt','updatedAt','endDate','status','employeeId','weekday','shift','employeeIds','excludedDays'])
        && data.keys().hasAll(['clientId','title','serviceType','frequency','startDate','estimatedDuration','areas','notes','createdAt','updatedAt'])
        && data.clientId is string && validId(data.clientId)
        && existsAfter(/databases/$(database)/documents/clients/$(data.clientId))
        && (!('employeeIds' in data) || (data.employeeIds is list && data.employeeIds.size() <= 5 && data.employeeIds.toSet().size() == data.employeeIds.size()))
        && (!('shift' in data) || data.shift in ['Manhã','Tarde','Noite','Dia inteiro'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.serviceType in ['Casa completa','Divisões específicas da casa','Condomínio','Escritório','Espaço comercial','Limpeza pós-obra','Outra limpeza']
        && (!(data.frequency in ['Semanal','Quinzenal']) || data.get('status','ativo') != 'ativo' || (data.weekday is int && data.weekday >= 1 && data.weekday <= 7 && data.shift in ['Manhã','Tarde','Noite']))
        && data.frequency in ['Pontual','Diário','Semanal','Quinzenal','Mensal','Outro']
        && data.startDate is string && validDay(data.startDate)
        && (!('status' in data) || data.status in ['ativo','concluido','cancelado'])
        && (!('endDate' in data) || (data.endDate is string && (data.endDate == '' || (validDay(data.endDate) && data.endDate >= data.startDate))))
        && (data.frequency != 'Pontual' || !('endDate' in data) || data.endDate == data.startDate)
        && data.estimatedDuration is string && data.estimatedDuration.size() <= 80
        && data.areas is string && data.areas.size() <= 5000
        && data.notes is string && data.notes.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /serviceCompletions/{id} {
      allow get: if request.auth != null && (isAdmin() ||
        (!exists(/databases/$(database)/documents/serviceCompletions/$(id))
          ? portalSelf(get(/databases/$(database)/documents/employeeAccess/$(request.auth.uid)).data.employeeId)
          : portalServiceWorker(resource.data.serviceId)));
      allow create: if request.auth != null && validId(id) && validServiceCompletion(request.resource.data,id)
        && request.resource.data.employeeIds.size() == 1 && workSelf(request.resource.data.employeeIds[0])
        && assignedServiceEmployee(request.resource.data.serviceId,request.resource.data.employeeIds[0])
        && workFinished(request.resource.data.serviceId,request.resource.data.day);
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validServiceCompletion(request.resource.data,id);
      allow update, delete: if false;
    }
    function validServiceCompletion(d,id) {
      let s = get(/databases/$(database)/documents/services/$(d.serviceId)).data;
      let parts = d.day.split('-');
      return d.keys().hasOnly(['serviceId','clientId','day','shift','employeeIds','status','createdAt'])
        && d.keys().hasAll(['serviceId','clientId','day','shift','employeeIds','status','createdAt'])
        && validId(d.serviceId) && id == d.serviceId + '-' + d.day && validDay(d.day)
        && s.frequency in ['Semanal','Quinzenal'] && (s.frequency != 'Quinzenal' || inFortnight(s.startDate,d.day)) && s.get('status','ativo') != 'cancelado'
        && s.clientId == d.clientId && s.shift == d.shift && weekOf(d.day) == s.weekday
        && d.day >= s.startDate && (s.get('endDate','') == '' || d.day <= s.endDate)
        && timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) <= request.time + duration.value(1,'h')
        && d.employeeIds is list && d.employeeIds.size() <= 5
        && d.status == 'concluida' && d.createdAt == request.time;
    }
    match /services/{id} {
      allow update: if request.auth != null && resource.data.frequency == 'Pontual' && resource.data.get('status','ativo') in ['ativo','concluido']
        && request.resource.data.status == 'concluido'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time && workFinished(id,resource.data.startDate)
        && (isAdmin() || portalServiceWorker(id));
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validService(request.resource.data) && serviceLock(id,request.resource.data) && activeEmployee(request.resource.data.get('employeeId',''))
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validService(request.resource.data) && serviceLock(id,request.resource.data) && changedEmployeeAllowed(request.resource.data,resource.data)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() && resource.data.status == 'cancelado';
    }
    function quoteFields(d) {
      return d.get('customerType','Profissional') in ['Particular','Profissional'] && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() <= 150
        && d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.clientId is string && (d.clientId == '' || exists(/databases/$(database)/documents/clients/$(d.clientId)))
        && d.date is string && validDay(d.date) && d.valid is string && validDay(d.valid) && d.valid >= d.date
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 30
        && d.discount is number && d.discount >= 0 && d.discount <= 100
        && d.vat is number && d.vat >= 0 && d.vat <= 100
        && d.scope is string && d.scope.size() <= 5000
        && d.terms is string && d.terms.size() <= 5000
        && d.notes is string && d.notes.size() <= 5000
        && d.address is string && d.address.size() <= 300
        && d.materials is string && d.materials.size() <= 500
        && d.taxnote is string && d.taxnote.size() <= 300
        && d.frequency in ['Pontual','Diário','Semanal','Quinzenal','Mensal','Outro']
        && d.type in ['Casa completa','Limpeza pós-obra','Condomínio','Escritório','Espaço comercial','Divisões específicas da casa','Outra limpeza']
        && d.updatedAt == request.time;
    }
    match /quoteCounters/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && id == 'main' && request.resource.data.keys().hasOnly(['value']) && request.resource.data.value == 1;
      allow update: if isAdmin() && id == 'main' && request.resource.data.keys().hasOnly(['value']) && request.resource.data.value == resource.data.value + 1;
    }
    match /quotes/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin() && resource.data.get('serviceId','') == '';
      allow create: if isAdmin() && validId(id) && quoteFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['customerType','name','email','address','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','notes','clientId','lines','number','revision','parentId','status','serviceId','linkId','createdAt','updatedAt'])
        && request.resource.data.status == 'rascunho' && request.resource.data.serviceId == ''
        && request.resource.data.number is string && request.resource.data.number.size() <= 30
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.parentId is string
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','serviceId','linkId','updatedAt'])
        && request.resource.data.status in ['rascunho','enviado','aceite','recusado','expirado']
        && (request.resource.data.get('linkId','') == '' || (
          request.resource.data.linkId.matches('^[a-f0-9]{64}$')
          && (request.resource.data.status != 'aceite' || (
            getAfter(/databases/$(database)/documents/quoteLinks/$(request.resource.data.linkId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/quoteLinks/$(request.resource.data.linkId)).data.quoteId == id))))
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.serviceId == resource.data.serviceId
          || (resource.data.serviceId == '' && request.resource.data.status == 'aceite'
            && request.resource.data.serviceId == 'quote-' + id
            && getAfter(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId == resource.data.clientId));
    }
    match /quoteTemplates/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validId(id)
        && request.resource.data.keys().hasOnly(['title','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.scope is string && request.resource.data.scope.size() <= 5000
        && request.resource.data.terms is string && request.resource.data.terms.size() <= 5000
        && request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }
    function cleanPublicQuote(d) {
      return d.keys().hasOnly(['customerType','address','name','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','number','revision'])
        && d.keys().hasAll(['name','title','date','valid','frequency','type','discount','vat','taxnote','scope','terms','materials','lines','number','revision']);
    }
    function linkShape(d) {
      return d.keys().hasOnly(['quoteId','quote','status','expiresAt','clientChoice','clientComment','clientAt','finalComment','finalAt','history','updatedAt'])
        && cleanPublicQuote(d.quote)
        && validId(d.quoteId) && d.expiresAt is timestamp
        && d.history is list && d.history.size() <= 20
        && d.clientComment is string && d.clientComment.size() <= 2000
        && d.finalComment is string && d.finalComment.size() <= 2000
        && d.updatedAt == request.time;
    }
    function snapshotMatches(d) {
      let q = getAfter(/databases/$(database)/documents/quotes/$(d.quoteId)).data;
      return d.quote.get('customerType','Profissional') == q.get('customerType','Profissional') && d.quote.get('address','') == q.get('address','') && d.quote.name == q.name && d.quote.title == q.title && d.quote.date == q.date
        && d.quote.valid == q.valid && d.quote.frequency == q.frequency && d.quote.type == q.type
        && d.quote.discount == q.discount && d.quote.vat == q.vat && d.quote.taxnote == q.taxnote
        && d.quote.scope == q.scope && d.quote.terms == q.terms && d.quote.materials == q.materials
        && d.quote.lines == q.lines && d.quote.number == q.number && d.quote.revision == q.revision;
    }
    match /quoteLinks/{token} {
      allow delete: if isAdmin()
        && (!exists(/databases/$(database)/documents/quotes/$(resource.data.quoteId))
          || get(/databases/$(database)/documents/quotes/$(resource.data.quoteId)).data.get('serviceId','') == '');
      allow list: if isAdmin();
      allow get: if isAdmin() || (token.matches('^[a-f0-9]{64}$') && resource.data.status != 'revoked');
      allow create: if isAdmin() && token.matches('^[a-f0-9]{64}$')
        && linkShape(request.resource.data) && snapshotMatches(request.resource.data)
        && request.resource.data.status == 'awaiting_client'
        && request.resource.data.clientChoice == '' && request.resource.data.clientComment == ''
        && request.resource.data.clientAt == null && request.resource.data.finalAt == null
        && request.resource.data.finalComment == '' && request.resource.data.history.size() == 0
        && request.resource.data.expiresAt > request.time;
      allow update: if (isAdmin() && linkShape(request.resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status == 'revoked')
        || (resource.data.status == 'awaiting_geslimp'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalComment','finalAt','updatedAt'])
          && request.resource.data.status in ['accepted','refused']
          && (request.resource.data.status != 'accepted' || resource.data.clientChoice == 'accepted')
          && request.resource.data.finalComment.size() > 0 && request.resource.data.finalAt == request.time)
        || (resource.data.status != 'revoked' && request.resource.data.quoteId != resource.data.quoteId
          && getAfter(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.parentId == resource.data.quoteId
          && snapshotMatches(request.resource.data)
          && request.resource.data.status == 'awaiting_client' && request.resource.data.expiresAt > request.time
          && request.resource.data.clientChoice == '' && request.resource.data.clientComment == ''
          && request.resource.data.clientAt == null && request.resource.data.finalAt == null && request.resource.data.finalComment == ''
          && request.resource.data.history.size() == resource.data.history.size() + 1)
      )) || (
        request.auth != null && token.matches('^[a-f0-9]{64}$')
        && resource.data.status == 'awaiting_client' && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientChoice','clientComment','clientAt','updatedAt'])
        && request.resource.data.status == 'awaiting_geslimp'
        && request.resource.data.clientChoice in ['accepted','refused']
        && request.resource.data.clientComment is string && request.resource.data.clientComment.size() <= 2000
        && (request.resource.data.clientChoice != 'refused' || request.resource.data.clientComment.size() > 0)
        && request.resource.data.clientAt == request.time && request.resource.data.updatedAt == request.time
      );
    }

    function employeeReference(d) {
      let id = d.get('employeeId','');
      return id is string && (id == '' || (validId(id) && exists(/databases/$(database)/documents/employees/$(id))));
    }
    function activeEmployee(id) {
      return id == '' || get(/databases/$(database)/documents/employees/$(id)).data.status == 'ativo';
    }
    function changedEmployeeAllowed(next, previous) {
      return next.get('employeeId','') == previous.get('employeeId','') || activeEmployee(next.get('employeeId',''));
    }
    function employeeRoleLevel(role) {
      return role == 'CEO / Gerente' ? 0 :
        (role in ['Gestor de operações','Supervisor','Encarregado','Responsável de qualidade','Responsável de segurança'] ? 1 :
        (role in ['Administrativo','Comercial','Atendimento ao cliente','Responsável de armazém','Manutenção','Motorista'] ? 2 : 3));
    }
    function validEmployee(d,id) {
      return d.keys().hasOnly(['name','phone','email','address','postcode','city','taxId','birthDate','role','jobTitle','department','managerId','entryDate','contractType','contractEnd','exitDate','status','notes','photoData','createdAt','updatedAt'])
        && d.keys().hasAll(['name','phone','email','address','postcode','city','taxId','birthDate','role','jobTitle','department','managerId','entryDate','contractType','contractEnd','exitDate','status','notes','photoData','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 40 && d.phone.matches('^[+0-9 ()-]+$') && d.email is string && d.email.size() <= 150 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && d.address is string && d.address.size() <= 300
        && d.postcode is string && (d.postcode == '' || d.postcode.matches('^[0-9]{4}-[0-9]{3}$'))
        && d.city is string && d.city.size() <= 100
        && d.taxId is string && (d.taxId == '' || d.taxId.matches('^[0-9]{9}$'))
        && d.birthDate is string && (d.birthDate == '' || (validDay(d.birthDate) && d.birthDate <= d.entryDate))
        && d.role in ['CEO / Gerente','Gestor de operações','Supervisor','Encarregado','Responsável de qualidade','Responsável de segurança','Administrativo','Comercial','Atendimento ao cliente','Responsável de armazém','Manutenção','Motorista','Técnico de limpeza','Auxiliar de limpeza','Limpeza industrial','Housekeeping','Outra função']
        && d.jobTitle is string && d.jobTitle.size() <= 100 && d.department is string && d.department.size() <= 100
        && d.managerId is string && (d.managerId == '' || (validId(d.managerId) && d.managerId != id
          && employeeRoleLevel(get(/databases/$(database)/documents/employees/$(d.managerId)).data.role) < employeeRoleLevel(d.role)))
        && d.entryDate is string && validDay(d.entryDate)
        && d.contractType in ['Sem termo','A termo certo','A termo incerto','Prestação de serviços','Estágio','Gerência / administração','Não aplicável','Outro']
        && d.contractEnd is string && (d.contractEnd == '' || (validDay(d.contractEnd) && d.contractEnd >= d.entryDate))
        && d.exitDate is string && (d.exitDate == '' || (validDay(d.exitDate) && d.exitDate >= d.entryDate))
        && d.status in ['ativo','inativo'] && (d.status == 'inativo' || d.exitDate == '')
        && d.notes is string && d.notes.size() <= 5000
        && d.photoData is string && d.photoData.size() <= 180000
        && (d.photoData == '' || d.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /employees/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && validEmployee(request.resource.data,id)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validId(id) && validEmployee(request.resource.data,id)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Stock: o inventário e os movimentos são atualizados na mesma transação.
    function stockItemShape(d) {
      return d.keys().hasOnly(['name','brand','kind','category','unit','minQtyMilli','targetQtyMilli','preferredSupplierId','reference','archived','notes','photoData','qtyMilli','onLoanMilli','inventoryValueCents','lastMovementId','lastSupplierId','createdAt','updatedAt'])
        && d.keys().hasAll(['name','brand','kind','category','unit','minQtyMilli','reference','archived','notes','photoData','qtyMilli','onLoanMilli','inventoryValueCents','lastMovementId','lastSupplierId','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.brand is string && d.brand.size() <= 100 && d.category is string && d.category.size() <= 100
        && d.kind in ['consumable','equipment'] && d.unit in ['unidade','embalagem','litro','kg']
        && (d.kind != 'equipment' || (d.unit == 'unidade' && d.qtyMilli % 1000 == 0 && d.onLoanMilli % 1000 == 0))
        && (!('targetQtyMilli' in d) || (d.targetQtyMilli is int && d.targetQtyMilli > d.minQtyMilli && d.targetQtyMilli <= 10000000 && (d.kind != 'equipment' || d.targetQtyMilli % 1000 == 0)))
        && (!('preferredSupplierId' in d) || (d.preferredSupplierId is string && d.preferredSupplierId.size() <= 128))
        && d.minQtyMilli is int && d.minQtyMilli >= 0 && d.minQtyMilli <= 10000000
        && d.qtyMilli is int && d.qtyMilli >= 0 && d.qtyMilli <= 10000000
        && d.onLoanMilli is int && d.onLoanMilli >= 0 && d.onLoanMilli <= 10000000
        && (d.kind == 'equipment' || d.onLoanMilli == 0)
        && d.inventoryValueCents is int && d.inventoryValueCents >= 0 && d.inventoryValueCents <= 1000000000
        && d.reference is string && d.reference.size() <= 150 && d.archived is bool
        && (!d.archived || (d.qtyMilli == 0 && d.onLoanMilli == 0))
        && d.notes is string && d.notes.size() <= 3000
        && d.photoData is string && d.photoData.size() <= 180000
        && (d.photoData == '' || d.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && d.lastMovementId is string && d.lastSupplierId is string
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function stockMovementShape(d) {
      return d.keys().hasOnly(['itemId','kind','qtyMilli','unitPriceCents','totalCents','employeeId','clientId','clientName','serviceId','supplierId','day','dueDay','loanId','notes','createdAt'])
        && d.keys().hasAll(['itemId','kind','qtyMilli','unitPriceCents','totalCents','employeeId','clientId','clientName','serviceId','supplierId','day','dueDay','loanId','notes','createdAt'])
        && d.itemId is string && validId(d.itemId) && d.kind in ['purchase','issue','loan','return']
        && d.qtyMilli is int && d.qtyMilli > 0 && d.qtyMilli <= 10000000
        && d.unitPriceCents is int && d.unitPriceCents >= 0 && d.unitPriceCents <= 10000000
        && d.totalCents is int && d.totalCents >= 0 && d.totalCents <= 1000000000
        && d.employeeId is string && d.clientId is string && d.clientName is string && d.clientName.size() <= 100 && d.serviceId is string && d.supplierId is string
        && d.day is string && validDay(d.day) && d.dueDay is string && d.loanId is string
        && d.notes is string && d.notes.size() <= 3000 && d.createdAt == request.time;
    }
    function stockDelta(id,old,next) {
      let m = getAfter(/databases/$(database)/documents/stockMovements/$(next.lastMovementId)).data;
      return !exists(/databases/$(database)/documents/stockMovements/$(next.lastMovementId))
        && m.itemId == id && m.createdAt == request.time && next.lastMovementId != old.lastMovementId
        && ((m.kind == 'purchase' && next.qtyMilli == old.qtyMilli + m.qtyMilli
          && next.onLoanMilli == old.onLoanMilli && next.inventoryValueCents == old.inventoryValueCents + m.totalCents
          && next.lastSupplierId == m.supplierId)
        || (m.kind == 'issue' && next.kind == 'consumable' && m.qtyMilli <= old.qtyMilli
          && next.qtyMilli == old.qtyMilli - m.qtyMilli && next.onLoanMilli == old.onLoanMilli
          && next.inventoryValueCents == old.inventoryValueCents - m.totalCents && next.lastSupplierId == old.lastSupplierId)
        || (m.kind == 'loan' && next.kind == 'equipment' && m.qtyMilli <= old.qtyMilli
          && next.qtyMilli == old.qtyMilli - m.qtyMilli && next.onLoanMilli == old.onLoanMilli + m.qtyMilli
          && next.inventoryValueCents == old.inventoryValueCents && next.lastSupplierId == old.lastSupplierId)
        || (m.kind == 'return' && next.kind == 'equipment' && m.qtyMilli <= old.onLoanMilli
          && next.qtyMilli == old.qtyMilli + m.qtyMilli && next.onLoanMilli == old.onLoanMilli - m.qtyMilli
          && next.inventoryValueCents == old.inventoryValueCents && next.lastSupplierId == old.lastSupplierId));
    }
    match /kitTemplates/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && id == 'default'
        && request.resource.data.keys().hasOnly(['rows','updatedAt'])
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /employeeKits/{employeeId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && existsAfter(/databases/$(database)/documents/employees/$(employeeId))
        && request.resource.data.keys().hasOnly(['rows','deliveredIds','createdAt','updatedAt'])
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 30
        && request.resource.data.deliveredIds == [] && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['rows','deliveredIds','createdAt','updatedAt'])
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 30
        && request.resource.data.deliveredIds is list && request.resource.data.deliveredIds.size() <= 30
        && request.resource.data.deliveredIds.hasAll(resource.data.deliveredIds)
        && (resource.data.deliveredIds.size() == 0 || request.resource.data.rows == resource.data.rows)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /stockItems/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && stockItemShape(request.resource.data) && request.resource.data.createdAt == request.time
        && ((request.resource.data.qtyMilli == 0 && request.resource.data.onLoanMilli == 0 && request.resource.data.inventoryValueCents == 0 && request.resource.data.lastMovementId == '' && request.resource.data.lastSupplierId == '')
          || stockDelta(id,{'qtyMilli':0,'onLoanMilli':0,'inventoryValueCents':0,'lastMovementId':'','lastSupplierId':''},request.resource.data));
      allow update: if isAdmin() && stockItemShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.kind == resource.data.kind && request.resource.data.unit == resource.data.unit
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','brand','category','minQtyMilli','targetQtyMilli','preferredSupplierId','reference','archived','notes','photoData','updatedAt'])
          || (!resource.data.archived && !request.resource.data.archived && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qtyMilli','onLoanMilli','inventoryValueCents','lastMovementId','lastSupplierId','updatedAt']) && stockDelta(id,resource.data,request.resource.data)));
      allow delete: if false;
    }
    function stockIssueClient(d) {
      return (d.clientId == '' && d.clientName == '' && d.serviceId == '') || (validId(d.clientId) && exists(/databases/$(database)/documents/clients/$(d.clientId)) && d.clientName == get(/databases/$(database)/documents/clients/$(d.clientId)).data.name
        && (d.serviceId == '' || (validId(d.serviceId) && get(/databases/$(database)/documents/services/$(d.serviceId)).data.clientId == d.clientId)));
    }
    function stockMovementKind(d,id,old) {
      return (d.kind == 'purchase' && d.employeeId == '' && d.clientId == '' && d.clientName == '' && d.serviceId == '' && d.dueDay == '' && d.loanId == ''
          && validId(d.supplierId) && existsAfter(/databases/$(database)/documents/stockSuppliers/$(d.supplierId))
          && d.totalCents == int(d.qtyMilli * d.unitPriceCents / 1000 + 0.5))
        || (d.kind == 'issue' && old.kind == 'consumable' && d.supplierId == '' && d.dueDay == '' && d.loanId == '' && d.unitPriceCents == 0
          && validId(d.employeeId) && get(/databases/$(database)/documents/employees/$(d.employeeId)).data.status == 'ativo'
          && d.qtyMilli <= old.qtyMilli && stockIssueClient(d)
          && d.totalCents == int(old.inventoryValueCents * d.qtyMilli / old.qtyMilli + 0.5))
        || (d.kind == 'loan' && old.kind == 'equipment' && d.qtyMilli % 1000 == 0 && d.totalCents == 0 && d.unitPriceCents == 0 && d.supplierId == '' && d.clientId == '' && d.clientName == '' && d.serviceId == ''
          && d.loanId == id && (d.dueDay == '' || (validDay(d.dueDay) && d.dueDay >= d.day))
          && get(/databases/$(database)/documents/employees/$(d.employeeId)).data.status == 'ativo'
          && getAfter(/databases/$(database)/documents/stockLoans/$(id)).data.itemId == d.itemId
          && getAfter(/databases/$(database)/documents/stockLoans/$(id)).data.qtyMilli == d.qtyMilli)
        || (d.kind == 'return' && old.kind == 'equipment' && d.qtyMilli % 1000 == 0 && d.totalCents == 0 && d.unitPriceCents == 0 && d.supplierId == '' && d.clientId == '' && d.clientName == '' && d.serviceId == '' && d.dueDay == ''
          && validId(d.loanId) && get(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.itemId == d.itemId
          && get(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.employeeId == d.employeeId
          && get(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.status == 'open'
          && d.day >= get(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.day
          && getAfter(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.remainingMilli == get(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.remainingMilli - d.qtyMilli
          && getAfter(/databases/$(database)/documents/stockLoans/$(d.loanId)).data.lastReturnId == id);
    }
    match /stockMovements/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && stockMovementShape(request.resource.data)
        && getAfter(/databases/$(database)/documents/stockItems/$(request.resource.data.itemId)).data.lastMovementId == id
        && stockMovementKind(request.resource.data,id,exists(/databases/$(database)/documents/stockItems/$(request.resource.data.itemId)) ? get(/databases/$(database)/documents/stockItems/$(request.resource.data.itemId)).data : {'kind':'consumable','qtyMilli':0,'inventoryValueCents':0});
      allow update, delete: if false;
    }
    function stockLoanShape(d) {
      return d.keys().hasOnly(['itemId','employeeId','qtyMilli','remainingMilli','day','dueDay','status','lastReturnId','createdAt','updatedAt'])
        && d.itemId is string && validId(d.itemId) && d.employeeId is string && validId(d.employeeId)
        && d.qtyMilli is int && d.qtyMilli > 0 && d.qtyMilli % 1000 == 0
        && d.remainingMilli is int && d.remainingMilli >= 0 && d.remainingMilli <= d.qtyMilli && d.remainingMilli % 1000 == 0
        && d.day is string && validDay(d.day) && d.dueDay is string && (d.dueDay == '' || (validDay(d.dueDay) && d.dueDay >= d.day))
        && ((d.remainingMilli > 0 && d.status == 'open') || (d.remainingMilli == 0 && d.status == 'returned'))
        && d.lastReturnId is string && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /stockLoans/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validId(id) && stockLoanShape(request.resource.data)
        && request.resource.data.remainingMilli == request.resource.data.qtyMilli && request.resource.data.lastReturnId == ''
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.kind == 'loan'
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.employeeId == request.resource.data.employeeId
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.day == request.resource.data.day
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.dueDay == request.resource.data.dueDay
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.itemId == request.resource.data.itemId
        && getAfter(/databases/$(database)/documents/stockMovements/$(id)).data.qtyMilli == request.resource.data.qtyMilli;
      allow update: if isAdmin() && stockLoanShape(request.resource.data) && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingMilli','status','lastReturnId','updatedAt'])
        && request.resource.data.remainingMilli < resource.data.remainingMilli
        && !exists(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastReturnId))
        && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastReturnId)).data.kind == 'return'
        && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastReturnId)).data.loanId == id
        && request.resource.data.remainingMilli == resource.data.remainingMilli - getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastReturnId)).data.qtyMilli;
